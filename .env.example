# CAPSULA local or self-hosted controller — never commit filled secrets
CAPSULA_API_KEY=REPLACE_WITH_A_RANDOM_48_BYTE_TOKEN
CAPSULA_DATA=./data
# Default: worker required. Do not enable host Docker on an internet-facing control plane.
CAPSULA_ALLOW_DIRECT_DOCKER=0
# Worker is optional until deployed on a separate isolated host
CAPSULA_WORKER_TOKEN=
CAPSULA_WORKER_ALLOWED_ENDPOINTS=
# Plug-and-play OpenAI-compatible model. For Agent Rush, set the two Vultr tokens
# and leave the model URL empty: inference pins https://api.vultrinference.com.
CAPSULA_MODEL_PROVIDER=self-hosted
CAPSULA_MODEL_URL=
CAPSULA_MODEL_HOST=
CAPSULA_MODEL_ALLOWED_MODELS=
CAPSULA_MODEL_API_KEY=
VULTR_API_KEY=
VULTR_INFERENCE_API_KEY=
VULTR_CHAT_MODEL=mimo-v2.6-flash
VULTR_REGION=ewr
VULTR_PLAN=vc2-1c-2gb
# Allow operator-pinned HTTP to an isolated Docker-network model hostname only
CAPSULA_MODEL_ALLOW_INTERNAL_HTTP=0
# Vision review is a separate approved model capability, never silently substituted.
CAPSULA_MODEL_VISION_MODELS=
# Opt-in autonomy scheduler starts only when explicitly deployed.
CAPSULA_AUTONOMY_POLL_SECONDS=15
