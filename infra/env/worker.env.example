CAPSULA_WORKER_TOKEN=REPLACE_WITH_RANDOM_48_BYTE_SECRET
CAPSULA_WORKER_ALLOWED_ENDPOINTS=http://127.0.0.1:8081
CAPSULA_BROWSER_ALLOWLIST=example.org
# Model provider configured on the controller, not the worker.
# Browser worker (dedicated VM only)
CAPSULA_BROWSER_ALLOWLIST=
CAPSULA_BROWSER_NETWORK=
CAPSULA_BROWSER_EGRESS_ENFORCED=0
# Keep in mind setting this flag is not a security proof; the firewall must exist.
