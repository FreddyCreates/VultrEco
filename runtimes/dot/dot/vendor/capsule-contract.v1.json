{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capsula.local/schemas/capsule-contract.v1.json",
  "title": "VAUL to CAPSULA portable computer contract",
  "type": "object",
  "required": ["schema","capsule","source","manifest","sealed_state","permissions","runtime","receipts"],
  "properties": {
    "schema": {"const":"capsule.contract.v1"},
    "capsule": {
      "type":"object","required":["id","mode","parent_hash","created_at"],
      "properties":{
        "id":{"type":"string","minLength":8},
        "mode":{"enum":["sealed-transfer","fork","read-only"]},
        "parent_hash":{"type":["string","null"]},
        "created_at":{"type":"string","minLength":1}
      },
      "additionalProperties":false
    },
    "source": {
      "type":"object","required":["product","instance_id","version"],
      "properties":{
        "product":{"const":"NOVASVAUL"},
        "instance_id":{"type":"string","minLength":1},
        "version":{"type":"string","minLength":1}
      },
      "additionalProperties":false
    },
    "manifest": {
      "type":"object","required":["content_hash","records","format"],
      "properties":{
        "content_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "records":{"type":"integer","minimum":0},
        "format":{"const":"novasvaul-encrypted-records-v1"},
        "files":{"type":"array","items":{"type":"object"}}
      },
      "additionalProperties":true
    },
    "sealed_state": {
      "type":"object","required":["ciphertext_only","vault_manifest","records"],
      "properties":{
        "ciphertext_only":{"const":true},
        "vault_manifest":{"type":"string","minLength":1},
        "records":{"type":"array","items":{"type":"object","required":["file","sha256","envelope"]}}
      },
      "additionalProperties":false
    },
    "permissions": {
      "type":"object","required":["default","filesystem","network","process","wallet","secrets"],
      "properties":{
        "default":{"const":"deny"},
        "filesystem":{"type":"object"},
        "network":{"type":"object"},
        "process":{"type":"object"},
        "wallet":{"type":"object"},
        "secrets":{"type":"object"}
      },
      "additionalProperties":false
    },
    "runtime": {
      "type":"object","required":["engine","entrypoint","state","compatibility"],
      "properties":{
        "engine":{"const":"NOVASVAUL"},
        "entrypoint":{"type":"string"},
        "state":{"enum":["resumable","read-only","forkable"]},
        "compatibility":{"type":"object"}
      },
      "additionalProperties":false
    },
    "receipts": {
      "type":"array","items":{
        "type":"object","required":["type","capsule_id","operation","content_hash","created_at"],
        "properties":{
          "type":{"enum":["export","import","handoff"]},
          "capsule_id":{"type":"string"},
          "operation":{"type":"string"},
          "content_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "created_at":{"type":"string"}
        }
      }
    }
  },
  "additionalProperties": false
}
